# ============================================
# MEGA CLAWD - Agent Configuration
# ============================================

# Agent Wallet (KEEP SECRET - DO NOT COMMIT)
AGENT_PRIVATE_KEY=0x_your_private_key_here

# Blockchain RPCs
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_KEY

# AI Provider
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ERC-8004 Agent Registry (Ethereum Mainnet)
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# Agent Identity
AGENT_NAME=MEGA CLAWD
AGENT_DESCRIPTION=Autonomous AI agent with onchain identity, x402 payments, and OpenClaw skills
AGENT_WEBSITE=https://megaclawd.eth.link
AGENT_ENS=megaclawd.eth

# x402 Payment Configuration
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAYMENT_TOKEN=USDC
X402_CHAIN=base

# x402guard - Skill Security Auditing (https://x402guard.xyz)
X402GUARD_MAX_RISK_SCORE=50
X402GUARD_DEFAULT_TIER=standard

# Clanker - Token Launch (https://clanker.world)
CLANKER_API_KEY=
# Leave blank to use SDK method, or set API key for REST API method

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_ENABLED=true

# $MEGACLAWD Token (Base) - Launched via Clanker
TOKEN_ADDRESS=0x1da14047c57e54f1097ae1ae314093a3c8490b07
TOKEN_SYMBOL=MEGACLAWD

# Server
PORT=3000
AGENT_API_PORT=8402
