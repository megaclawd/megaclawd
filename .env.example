# ============================================
# MEGA CLAWD - Environment Variables Template
# Copy to .env and fill in your values
# NEVER commit .env to git!
# ============================================

# Agent Wallet (KEEP SECRET)
AGENT_PRIVATE_KEY=0x_your_evm_private_key_here

# Blockchain RPCs
ETHEREUM_RPC_URL=https://eth.llamarpc.com
BASE_RPC_URL=https://base.llamarpc.com

# AI Provider
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ERC-8004 Agent Registry (Ethereum Mainnet)
ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432

# Agent Identity
AGENT_NAME=MEGA CLAWD
AGENT_DESCRIPTION=Autonomous AI agent with onchain identity, x402 payments, and OpenClaw skills
AGENT_WEBSITE=https://megaclawd.eth.link
AGENT_ENS=megaclawd.eth

# x402 Payment Configuration
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_PAYMENT_TOKEN=USDC
X402_CHAIN=base

# x402guard - Skill Security Auditing
X402GUARD_MAX_RISK_SCORE=50
X402GUARD_DEFAULT_TIER=standard

# Clanker - Token Launch
CLANKER_API_KEY=

# OpenClaw Gateway
OPENCLAW_GATEWAY_URL=ws://127.0.0.1:18789
OPENCLAW_ENABLED=true

# $MEGACLAWD Token (Base)
TOKEN_ADDRESS=0x1da14047c57e54f1097ae1ae314093a3c8490b07
TOKEN_SYMBOL=MEGACLAWD

# Twitter/X API
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_SECRET=your_twitter_access_secret

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Solana
SOLANA_PRIVATE_KEY=your_base58_solana_private_key
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Server
PORT=3000
AGENT_API_PORT=8402

# Frontend (used by Next.js on Vercel)
NEXT_PUBLIC_AGENT_API_URL=http://localhost:8402

# CORS (comma-separated origins allowed to hit the agent API)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
