{
  "name": "mega-clawd-agent",
  "version": "1.0.0",
  "description": "MEGA CLAWD - Autonomous AI Agent with ERC-8004 identity, x402 payments, and OpenClaw integration",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "agent": "tsx src/agent/index.ts",
    "agent:dev": "tsx watch src/agent/index.ts",
    "register-8004": "tsx scripts/register-8004.ts",
    "deploy-token": "tsx scripts/deploy-token.ts",
    "launch-token": "tsx scripts/deploy-token.ts",
    "setup-wallet": "tsx scripts/setup-wallet.ts",
    "compile": "forge build --root contracts",
    "test:contracts": "forge test --root contracts -vvv",
    "lint": "next lint"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "viem": "^2.21.0",
    "wagmi": "^2.14.0",
    "@tanstack/react-query": "^5.62.0",
    "@rainbow-me/rainbowkit": "^2.2.0",
    "ai": "^4.0.0",
    "@ai-sdk/anthropic": "^1.0.0",
    "ws": "^8.18.0",
    "express": "^4.21.0",
    "dotenv": "^16.4.0",
    "zod": "^3.23.0",
    "chalk": "^5.3.0",
    "ora": "^8.1.0",
    "clanker-sdk": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.5.0",
    "@types/express": "^5.0.0",
    "tailwindcss": "^3.4.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
